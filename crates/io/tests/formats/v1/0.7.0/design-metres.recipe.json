  {"command": "model.material.create", "params": {"name": "ABS", "elastic": {"type": "isotropic", "young": 2300000000.0, "poisson": 0.35}, "density": 1050}},
  {"command": "model.section.create", "params": {"name": "solid", "set": "all", "material": "ABS", "kind": {"type": "solid"}}},
