[
  {"command": "geometry.open", "params": {"path": "hollow-box.solidcraft"}},
  {"command": "model.units", "params": {"system": "m-kg-s-N-Pa"}},
  {"command": "mesh.seed.edge", "params": {"edges": [{"body": "Case", "edge": "F1:+y|F3:+z"}], "size": 8}},
  {"command": "mesh.size.set", "params": {"name": "Lid", "size": 6, "faces": [{"body": "Case", "face": "F3:+z"}]}},
