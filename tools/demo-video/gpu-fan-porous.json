  {"command":"results.slice","params":{"field":"temperature","axis":"y"}},
  {"command":"results.contour","params":{"field":"temperature","range":{"min":20,"max":50}}},
  {"command":"results.surface","params":{"show":true}},
  {"command":"results.streamlines","params":{"show":true}},
  {"command":"results.frame","params":{"frame":10}}
